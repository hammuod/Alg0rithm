{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ar",
      "destination": "/?lang=ar",
      "permanent": true
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*?lang=ar",
      "permanent": true
    },
    {
      "source": "/fr",
      "destination": "/?lang=fr",
      "permanent": true
    },
    {
      "source": "/fr/:path*",
      "destination": "/:path*?lang=fr",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "packages.alg0rithm.dev"
        }
      ],
      "destination": "/packages/packages",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "builds.alg0rithm.dev"
        }
      ],
      "destination": "/builds/bulids",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/i18n/(en|ar|fr).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
